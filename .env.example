# OpenAI-compatible API credentials
# Works with OpenAI, Poe, Azure OpenAI, local proxies, etc.
API_KEY=your_api_key_here
API_BASE_URL=https://api.openai.com/v1

# Comma-separated model IDs shown in Settings (must match your provider)
# Mix of cheap/fast + strong general models; skip image/video-only bots
API_MODELS=Claude-Haiku-4.5,Claude-Opus-5,Claude-Sonnet-5,DeepSeek-V4-Flash,DeepSeek-V4-Pro,Gemini-3.5-Flash-Lite,Gemini-3.7-Flash,GPT-5.4-Mini,GPT-5.4-Nano,GPT-5.6-Luna,GPT-5.6-Sol,GPT-5.6-Terra,Grok-4.6
API_DEFAULT_MODEL=GPT-5.4-Mini

# Server
HOST=127.0.0.1
PORT=6353
FLASK_DEBUG=1
