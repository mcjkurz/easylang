# OpenAI-compatible API credentials
# Works with OpenAI, Poe, Azure OpenAI, local proxies, etc.
API_KEY=your_api_key_here
API_BASE_URL=https://api.openai.com/v1

# Comma-separated model IDs shown in Settings (must match your provider)
# ~half cheap/fast, ~half stronger general models
API_MODELS=Claude-Haiku-4.5,Claude-Opus-4.8,Claude-Sonnet-4.6,Gemini-3.1-Flash-Lite,Gemini-3.5-Flash-Lite,Gemini-3.7-Flash,GPT-5.4,GPT-5.4-Mini,GPT-5.4-Nano,Grok-4.1-Fast-Reasoning,Grok-4.6,MiMo-V2-Flash
API_DEFAULT_MODEL=GPT-5.4-Mini

# Server
HOST=127.0.0.1
PORT=6353
FLASK_DEBUG=1

# Optional app password (leave empty to allow open access)
PASSWORD=
# Optional; used to sign session cookies. Auto-derived from PASSWORD when set.
# SECRET_KEY=
